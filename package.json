{
  "name": "mehndi-booking-platform",
  "version": "1.0.0",
  "description": "Mehndi & Nail Art Booking Platform - Production Ready",
  "private": true,
  "scripts": {
    "generate-secrets": "node generate-secrets.js",
    "validate": "node validate-deployment.js",
    "deploy": "node validate-deployment.js && docker-compose -f docker-compose.prod.yml up -d --build",
    "deploy:down": "docker-compose -f docker-compose.prod.yml down",
    "logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "status": "docker-compose -f docker-compose.prod.yml ps",
    "install:all": "cd Backend && npm install && cd ../\"Mehndi Web\" && npm install",
    "dev:backend": "cd Backend && npm run dev",
    "dev:frontend": "cd \"Mehndi Web\" && npm run dev",
    "build:frontend": "cd \"Mehndi Web\" && npm run build:prod",
    "seed:prod": "cd Backend && npm run seed:prod"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "react-router-dom": "^7.15.0"
  }
}
