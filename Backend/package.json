{
  "name": "mehndi-booking-backend",
  "version": "1.0.0",
  "description": "Backend for Mehndi & Nail Art Booking Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "seed": "node seed.js",
    "seed:prod": "NODE_ENV=production node seed.js",
    "generate-secrets": "node ../generate-secrets.js",
    "docker:build": "docker build -t mehndi-backend .",
    "docker:run": "docker run -p 5000:5000 --env-file .env.production mehndi-backend",
    "health-check": "node healthcheck.js"
  },
  "keywords": [
    "mehndi",
    "booking",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
